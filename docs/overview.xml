ALTER TABLE conversation_goals
    ADD COLUMN IF NOT EXISTS goal_type VARCHAR(30)
    CHECK (goal_type IN (
        'trip_plan',
        'food_search',
        'price_watch',
        'recommendation',
        'onboarding',
        're_engagement',
        'upsell',
        'general'
    ));
